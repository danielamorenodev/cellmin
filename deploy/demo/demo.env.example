# Configuración de la DEMOSTRACIÓN. Copiar como /opt/cellmin/demo.env y completar.
# Nunca se sube a GitHub. Tiene que ser distinta en todo a la del sistema del local.
# Cada valor va entre comillas dobles (la conexión de Atlas tiene caracteres como &).

# Usuario de Atlas propio de la demo, con permiso SOLO sobre la base cellmin_demo
MONGODB_URL="mongodb+srv://USUARIO_DEMO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
# El nombre tiene que contener "demo": el script de carga se niega a correr si no
DATABASE_NAME="cellmin_demo"

# Clave propia de la demo (32 caracteres o más):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""

ENTORNO="produccion"
CORS_ORIGINS="https://demo.cellmin.jybora.com"
