# Servicio del backend. Se copia a /etc/systemd/system/cellmin-backend.service
[Unit]
Description=Cellmin - API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=cellmin
Group=cellmin
WorkingDirectory=/opt/cellmin/backend
# Un solo proceso: los registros (logs) rotan en archivos y no admiten varios procesos a la vez
ExecStart=/opt/cellmin/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

# Endurecimiento básico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/cellmin/backend/logs

[Install]
WantedBy=multi-user.target
