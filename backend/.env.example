# Copiá este archivo como ".env" (en la misma carpeta) y completá los valores.
# El archivo ".env" NUNCA se sube a GitHub.

# Cadena de conexión de MongoDB Atlas (usuario propio de producción, con
# permiso de lectura/escritura solo sobre la base cellmin_prod)
MONGODB_URL=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=cellmin_prod

# Clave para firmar los inicios de sesión. Mínimo 32 caracteres, única y secreta.
# Generarla con:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# En el servidor: produccion (oculta /docs y exige clave larga). En tu PC: desarrollo
ENTORNO=produccion

# Dominios desde los que se permite usar la API (separados por coma)
CORS_ORIGINS=https://cellmin.jybora.com
